          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_items_fts_AFTER_INSERT AFTER INSERT ON `items` BEGIN INSERT INTO `items_fts`(`docid`, `title`, `content`, `originalFileName`, `extractedText`, `aiDescription`, `aiConcepts`) VALUES (NEW.`rowid`, NEW.`title`, NEW.`content`, NEW.`originalFileName`, NEW.`extractedText`, NEW.`aiDescription`, NEW.`aiConcepts`); END"
