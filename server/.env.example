# Server Environment Configuration
PORT=8081
# Google Gemini API key (kept exclusively on the server, never in Android APK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
MAX_BODY_BYTES=2097152
REQUEST_TIMEOUT_MS=30000
DEVICE_ENROLLMENT_SECRET=your_device_enrollment_secret_here
SESSION_SIGNING_SECRET=your_session_signing_secret_here
